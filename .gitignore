node_modules/
dist/
.env
*.log

# Trace runs are demo evidence, not source. Keep a couple of curated
# example runs committed deliberately; don't let every local run
# accumulate in the repo. The one official batch-evidence folder (full
# per-transaction traces, not just an aggregate) is force-added explicitly
# when finalized -- see README "Evidence" section for which one that is.
/traces/*.json
/traces/batch-evidence-*/
/traces/refund-batch-*.json
!/traces/.gitkeep
!/traces/example-run-drift.json
!/traces/example-run-oos.json
!/traces/example-run-gemini.json
