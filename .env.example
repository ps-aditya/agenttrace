# Copy this file to .env and fill in your Razorpay TEST MODE keys.
# Test mode keys require no website verification -- generate them from:
# Razorpay Dashboard -> Account & Settings -> API Keys -> (Test Mode) -> Generate Key
#
# If these are left unset, AgentTrace falls back to a clearly-labeled mock
# payment response so the demo still runs end-to-end for anyone.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
