# Copy this file to .env and fill in your Razorpay TEST MODE keys.
# Test mode keys require no website verification -- generate them from:
# Razorpay Dashboard -> Account & Settings -> API Keys -> (Test Mode) -> Generate Key
#
# If these are left unset, AgentTrace falls back to a clearly-labeled mock
# payment response so the demo still runs end-to-end for anyone.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: only needed for `npm run demo:gemini` (real LLM-driven decisions
# instead of the default rule-based brain). Gemini's free tier requires no
# credit card -- get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only needed for `npm run verify-payment`'s strongest evidence
# path (a signature-verified webhook, not just a polled status check).
# Set this to the exact secret you configure in Razorpay Dashboard ->
# Settings -> Webhooks when you register your tunnel URL. If left unset,
# verify-payment falls back to polling automatically -- still real data,
# just weaker evidence (see README for the distinction).
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_PORT=3737
